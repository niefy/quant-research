# Copy to .env and adjust for local development. Never commit .env.
QUANT_ENV=development

# --- Storage ---------------------------------------------------------------
# Local Binance parquet root: <dir>/<SYMBOL>/<SYMBOL>-<frequency>.parquet
QUANT_DATA_DIR=../../binance_data
QUANT_ARTIFACT_DIR=data/artifacts

# --- Metadata / queue (M3+) ------------------------------------------------
QUANT_DATABASE_URL=postgresql+psycopg://quant:quant@localhost:5432/quant
QUANT_REDIS_URL=redis://localhost:6379/0

# --- API security (M3+) ----------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
QUANT_JWT_SECRET=change-me
QUANT_API_PORT=8000

# --- LLM gateway (M4+) -----------------------------------------------------
# ANTHROPIC_API_KEY=
QUANT_LLM_MODEL=claude-sonnet-5
QUANT_LLM_MONTHLY_BUDGET_USD=50
